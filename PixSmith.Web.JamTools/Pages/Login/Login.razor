@page "/login"

<PageTitle>Sign in — Jam Tools</PageTitle>

<div class="login-wrap">
    <div class="panel login-card">

        <div class="login-brand">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" style="color:#d4af37;">
                <path d="M12 3a9 9 0 1 0 9 9A9 9 0 0 0 12 3zm0 16a7 7 0 1 1 7-7 7 7 0 0 1-7 7zm.5-11.5v5.17l3.67 3.67-1.41 1.41L11 14.08V7.5z" />
                <path d="M9 7h2v5H9zm4 0h2v3h-2z" opacity=".5" />
            </svg>
            <span class="brand-text">Jam Tools</span>
        </div>

        <p class="login-subtitle">Sign in to sync your tunings and saved scales.</p>

        <div class="login-fields">
            <FluentTextField @bind-Value="_email"
                             TextFieldType="TextFieldType.Email"
                             Placeholder="you@example.com"
                             Autofocus="true"
                             Style="width:100%">
                Email
            </FluentTextField>

            <FluentTextField @bind-Value="_password"
                             TextFieldType="TextFieldType.Password"
                             Placeholder="••••••••"
                             Style="width:100%">
                Password
            </FluentTextField>
        </div>

        <div class="login-row">
            <FluentCheckbox @bind-Value="_rememberMe">Remember me</FluentCheckbox>
            <a class="login-link" href="login">Forgot password?</a>
        </div>

        @if (_message is not null)
        {
            <div class="login-note" role="status">@_message</div>
        }

        <FluentButton Appearance="Appearance.Accent"
                      OnClick="HandleSignInAsync"
                      Loading="_busy"
                      Style="width:100%">
            Sign in
        </FluentButton>

        <div class="login-divider"><span>or</span></div>

        <a class="login-guest" href="">Continue without an account</a>
    </div>
</div>

@code {
    private string? _email;
    private string? _password;
    private bool _rememberMe;
    private bool _busy;
    private string? _message;

    // Placeholder: no auth backend is wired up yet. Replace the body of the try
    // block with a call into the API once /api/auth exists on the host.
    private async Task HandleSignInAsync()
    {
        _message = null;

        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        {
            _message = "Enter an email and password to continue.";
            return;
        }

        // An exception escaping a Blazor event handler is unhandled and takes the
        // whole app down (the #blazor-error-ui bar, then nothing responds). Keep
        // failures on the page instead, and never leave the button stuck loading.
        try
        {
            _busy = true;
            await Task.Delay(400);

            _message = "Sign-in isn't connected yet — this page is UI only for now.";
        }
        catch (Exception ex)
        {
            _message = $"Sign-in failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }
}
