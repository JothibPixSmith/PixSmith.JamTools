@page "/login"
@inject NavigationManager Navigation

<PageTitle>Sign in — Jam Tools</PageTitle>

<div class="login-wrap">
    <div class="panel login-card">

        <div class="login-brand">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" style="color:#d4af37;">
                <path d="M12 3a9 9 0 1 0 9 9A9 9 0 0 0 12 3zm0 16a7 7 0 1 1 7-7 7 7 0 0 1-7 7zm.5-11.5v5.17l3.67 3.67-1.41 1.41L11 14.08V7.5z" />
                <path d="M9 7h2v5H9zm4 0h2v3h-2z" opacity=".5" />
            </svg>
            <span class="brand-text">Jam Tools</span>
        </div>

        <p class="login-subtitle">Sign in to sync your tunings and saved scales.</p>

        @if (_error is not null)
        {
            <div class="login-note" role="alert">@_error</div>
        }

        <FluentButton Appearance="Appearance.Accent"
                      OnClick="SignIn"
                      Loading="_redirecting"
                      Style="width:100%">
            Sign in with PixSmith
        </FluentButton>

        <p class="login-hint">
            You'll be taken to the PixSmith account page to enter your credentials,
            then returned here. Jam Tools never sees your password.
        </p>

        <div class="login-divider"><span>or</span></div>

        <a class="login-guest" href="">Continue without an account</a>
    </div>
</div>

@code {
    private bool _redirecting;
    private string? _error;

    // The host redirects here with ?error=... when the callback fails.
    protected override void OnInitialized()
    {
        var query = new Uri(Navigation.Uri).Query;

        _error = query switch
        {
            _ when query.Contains("error=no_access", StringComparison.Ordinal) =>
                "Your account signed in, but your company doesn't have access to Jam Tools. "
                + "Ask an administrator to subscribe your organisation to this app.",
            _ when query.Contains("error=signin_failed", StringComparison.Ordinal) =>
                "That sign-in didn't complete. Please try again.",
            _ => null,
        };
    }

    // Must be a full-page navigation: the browser has to follow the redirect chain
    // to the auth server and back. A fetch would be blocked and would lose the
    // top-level context the correlation cookie depends on.
    private void SignIn()
    {
        _redirecting = true;
        Navigation.NavigateTo("api/auth/login?returnUrl=/success", forceLoad: true);
    }
}
