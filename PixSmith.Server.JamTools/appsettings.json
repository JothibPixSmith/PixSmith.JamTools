{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Sign-in against the PixSmith auth server. "Authority" must match the issuer in
  // its discovery document byte for byte, trailing slash included, or token
  // validation rejects everything it mints.
  "Oidc": {
    "Authority": "http://127.0.0.1:8080/",

    // One client per DEPLOYMENT, not per application. A client secret (or key) is the
    // client's identity, and the server cannot tell two deployments sharing a client id
    // apart — so a leaked staging credential would mint production tokens, and rotating
    // would break every environment at once. Register jamtools-web-prod / -staging
    // separately, with identical scopes.
    "ClientId": "jamtools-web-local",

    // "PrivateKeyJwt" (the default) authenticates with a signed assertion: this app keeps
    // a private key, the auth server stores only the public half. "ClientSecret" falls
    // back to the shared secret in appsettings.Development.json.
    "ClientAuthentication": "PrivateKeyJwt",
    "SigningKeyPath": "keys/client-signing-key.pem",
    "ClientSecret": "",

    // The company (tenancy) to authorize into. Empty = let the auth server resolve
    // it: a user with one membership goes straight through, one with several is
    // prompted. Set a tenancy slug or id to pin this app to a single company.
    "Organization": "",

    // "api" is shared by every app on this auth server today, so a token minted
    // here is audience-valid elsewhere. When the auth server gives each app its own
    // scope and resource (stage 6 of its multi-tenancy rollout), swap "api" for the
    // Jam Tools scope — this list is the only place that needs to change.
    "Scopes": [ "openid", "profile", "email", "roles", "offline_access", "api" ]
  }
}
