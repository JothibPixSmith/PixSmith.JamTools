{
  "version": "0.2.0",
  "configurations": [
    {
      // ── Default F5. Use this for anything involving sign-in. ──────────────
      // Server-side C# breakpoints work (including the OIDC callback and the
      // token exchange). No JavaScript debugger is attached to the browser, so
      // the OAuth redirect to the auth server and back cannot end the session.
      "name": "🔑 Server + SPA (survives sign-in)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-server",
      "program": "${workspaceFolder}/PixSmith.Server.JamTools/bin/Debug/net10.0/PixSmith.Server.JamTools.dll",
      "cwd": "${workspaceFolder}/PixSmith.Server.JamTools",
      "args": [],
      "stopAtEntry": false,
      "console": "internalConsole",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5080"
      }
    },
    {
      // ── Client-side C# breakpoints, in the browser. ───────────────────────
      // WARNING: the sign-in redirect leaves this app's origin, and the browser
      // debug session does not survive the round trip. When it ends, the C#
      // extension kills the server session with it — that pairing is hardcoded
      // in the adapter (cascadeTerminateToConfigurations) and cannot be turned
      // off from here. Use this config for fretboard/UI work, not sign-in.
      "name": "🚀 Server + SPA (debug client C#, breaks on sign-in)",
      "type": "blazorwasm",
      "request": "launch",
      "hosted": true,
      "preLaunchTask": "build-server",
      "program": "${workspaceFolder}/PixSmith.Server.JamTools/bin/Debug/net10.0/PixSmith.Server.JamTools.dll",
      "cwd": "${workspaceFolder}/PixSmith.Server.JamTools",
      "url": "http://localhost:5080",
      // "browser" only accepts "chrome" | "edge" — "chrome" selects the
      // Chromium-family debugger, and browserConfig points it at the actual
      // binary (swap runtimeExecutable if you install Chromium natively).
      "browser": "chrome",
      "browserConfig": {
        // Not the Flatpak's own wrapper — that one orphans the browser when the
        // debug session ends. See the comments in chromium-debug.sh.
        "runtimeExecutable": "${workspaceFolder}/.vscode/chromium-debug.sh",
        // Flatpak Chromium has no access to $HOME, so the debug profile has to
        // live inside the app's own sandbox-writable directory.
        "userDataDir": "/home/base/.var/app/org.chromium.Chromium/config/vscode-debug"
      },
      // With "hosted": true the adapter launches the DLL directly (not "dotnet
      // run"), so Properties/launchSettings.json is NOT read and the server would
      // fall back to :5000 while the browser opens "url" above. Bind it here.
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5080"
      }
    },
    {
      "name": "🔒 Server only (https)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-server",
      "program": "${workspaceFolder}/PixSmith.Server.JamTools/bin/Debug/net10.0/PixSmith.Server.JamTools.dll",
      "cwd": "${workspaceFolder}/PixSmith.Server.JamTools",
      "args": [],
      "stopAtEntry": false,
      "console": "internalConsole",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7080;http://localhost:5080"
      }
    },
    {
      // No backend — the standalone WASM dev server, same as GitHub Pages serves
      // it. Sign-in does not work here: there is no host to hold the tokens.
      "name": "🌐 SPA standalone (no backend, no sign-in)",
      "type": "blazorwasm",
      "request": "launch",
      "cwd": "${workspaceFolder}/PixSmith.Web.JamTools",
      "browser": "chrome",
      "browserConfig": {
        "runtimeExecutable": "${workspaceFolder}/.vscode/chromium-debug.sh",
        "userDataDir": "/home/base/.var/app/org.chromium.Chromium/config/vscode-debug"
      }
    },
    {
      "name": "🔗 Attach to running server",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}
